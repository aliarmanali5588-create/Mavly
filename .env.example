GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=
# Customer-owned Supabase via Management API OAuth. This is the Management API
# OAuth app (api.supabase.com), NOT Supabase Auth's OAuth 2.1 server: it
# authorizes Mavly to act on the user's organizations and projects.
# Register the app with exactly these scopes: projects:read,
# organizations:read, database:read, database:write, edge_functions:read.
# The redirect URI must be https://<origin>/auth/supabase/callback (http is
# accepted on loopback for local work) and carries no query or fragment.
# Without all four variables every Supabase OAuth route answers
# 503 SUPABASE_OAUTH_NOT_CONFIGURED and names what is missing.
# SUPABASE_OAUTH_CLIENT_SECRET is server-only: never give it a NEXT_PUBLIC_ prefix.
# The encryption key is shared with the GitHub integration on purpose; AAD still
# binds each ciphertext to supabase-oauth:<purpose>:<userId>:<projectId>.
SUPABASE_OAUTH_CLIENT_ID=
SUPABASE_OAUTH_CLIENT_SECRET=
SUPABASE_OAUTH_REDIRECT_URI=
# Managed Neon database + generated-app data API. OFF by default. Production use
# requires Neon Agent Plan approval (active Scale plan + Neon team approval),
# migrations 30, 35 and 37, and an enrollment configuration below. Set the
# approval variable only after Neon confirms the platform enrollment. Each
# project receives a separate Neon project with bounded quotas.
# `ready` means more than "a database exists": the validated application schema
# was applied and read back, and the data gateway is configured. Generated apps
# call Mavly's data API; they never receive a connection string.
# The encryption key must be 32 random bytes, base64-encoded, and is server-only.
# Keep it stable; rotation requires re-encrypting existing registry values.
MAVLY_MANAGED_BACKENDS_ENABLED=
MAVLY_NEON_AGENT_PLAN_APPROVED=
# LEGACY authorization path. Leave the enrollment mode below UNSET to keep using
# this static project list. Once MAVLY_MANAGED_BACKENDS_ENROLLMENT_MODE is set,
# this list stops being an authorization source (it becomes the `allowlisted`
# cohort) and may be left empty. `*` is always refused.
MAVLY_MANAGED_BACKENDS_PROJECTS=
# ── Automatic enrollment (migration 37) ─────────────────────────────────────
# UNSET = legacy static allowlist (above). Any explicit value switches to the
# database-backed enrollment registry, where trusted server policy decides.
#   disabled             no automatic enrollment (safe default when set)
#   internal             only MAVLY_MANAGED_BACKENDS_INTERNAL_PROJECTS
#   allowlisted          only MAVLY_MANAGED_BACKENDS_PROJECTS
#   percentage           a deterministic slice of eligible projects
#   general_availability every eligible project (capacity-bounded)
# Roll out in that order. Never start at general_availability.
MAVLY_MANAGED_BACKENDS_ENROLLMENT_MODE=
# Explicit internal/test projects, for `internal` mode. Comma-separated slugs.
MAVLY_MANAGED_BACKENDS_INTERNAL_PROJECTS=
# 0-99. Required for `percentage`; a missing or malformed value is REFUSED, never
# defaulted upward. Admission is `bucket < percent`, so raising this only ever
# adds projects and lowering it never revokes an existing enrollment.
MAVLY_MANAGED_BACKENDS_ROLLOUT_PERCENT=
# Server-only salt (>= 16 chars; generate 32 random bytes). Required for
# `percentage`. Changing it reshuffles every bucket, so treat it as permanent.
MAVLY_MANAGED_BACKENDS_ROLLOUT_SALT=
# Ceiling on projects provisioning concurrently (1-50, default 5).
MAVLY_MANAGED_BACKENDS_MAX_ACTIVE_PROVISIONS=
NEON_API_KEY=
NEON_ORG_ID=
NEON_REGION_ID=
MAVLY_MANAGED_BACKENDS_ENCRYPTION_KEY=
# Absolute https origin of this deployment's data gateway, e.g.
# https://app.example.com. Generated apps call `<origin>/api/app/v1/apps/
# <project-id>/...`. Must be same-site with the published `*.mavly.xyz` host for
# cookie transport; the API also accepts `Authorization: Bearer`.
MAVLY_APP_GATEWAY_ORIGIN=
# Server-only proof attached to every data-gateway RPC (>= 32 chars). Without
# it the public project id alone cannot read the encrypted connection URI.
# Rotating it requires re-configuring each ready backend.
MAVLY_MANAGED_BACKENDS_RPC_SECRET=
MAVLY_IMAGE_MODEL=
# Planning-driven website imagery (migration 33). Off by default: when unset the
# planner is not asked for an image plan and no image is generated. Every image
# is one paid `recraft/recraft-v4.1-flash` call through OpenRouter's dedicated
# image API, stored in the private-write/public-read `project-images` bucket.
MAVLY_IMAGE_PLANNING_ENABLED=
# Maximum NEW assets for a standard run. Clamped to 1..40; defaults to 40. A
# large-catalog cohort project uses its own 80-asset ceiling instead, so do not
# add a project to the cohort below if you want it bounded by this value.
MAVLY_IMAGE_MAX_ASSETS=
# Provider spend ceiling per run, in USD. Clamped to 0..1; defaults to 0.30.
# This is OPERATOR spend, not a Mavly credit charge.
MAVLY_IMAGE_MAX_RUN_COST_USD=
# Comma-separated project ids allowed to reach the 80-asset large-catalog
# ceiling. Empty or '*' authorizes nobody; the plan must also name a catalog.
MAVLY_IMAGE_LARGE_CATALOG_PROJECTS=
# Parallel provider calls (1..4, default 2) and per-asset timeout in ms
# (5000..120000, default 45000). Attempts per asset: 1..3, default 2.
MAVLY_IMAGE_CONCURRENCY=
MAVLY_IMAGE_TIMEOUT_MS=
MAVLY_IMAGE_MAX_ATTEMPTS=
# Storage bucket for generated website imagery. Defaults to project-images, which
# migration 33 creates and policies. A different bucket name must be created and
# policied separately (owner-write on the project folder, public read).
MAVLY_IMAGE_STORAGE_BUCKET=
# ═══ LIVE RUNTIME PREVIEW (PHASE 13, OFF BY DEFAULT) ════════════════════════
# A real Vite dev server for an existing React + Vite project, running in an
# isolated E2B sandbox and shown in the workspace. Enabling requires ALL of: the
# flag, E2B_API_KEY, and NEXT_PUBLIC_SUPABASE_URL. There is NO per-project
# allowlist: once the flag is on, every eligible project owned by the caller is
# authorized automatically. Eligibility is detected from the persisted files
# (React + Vite + npm only); Next.js, Android, SvelteKit and other frameworks
# report their exact unsupported reason. The sandbox is created from persisted
# project files only; nothing is written back to project_files. Apply migration
# 34 first.
MAVLY_RUNTIME_SANDBOX_ENABLED=
# OPTIONAL restriction. Leave empty (or `*`) to authorize every eligible
# project. Set explicit comma/semicolon-separated project ids only to narrow
# access temporarily; this is not required for new projects.
MAVLY_RUNTIME_SANDBOX_PROJECTS=
# Server-only E2B key. Never prefix with NEXT_PUBLIC_ and never store it in the DB.
E2B_API_KEY=
# E2B template that must provide Node + npm (default `base`).
MAVLY_RUNTIME_SANDBOX_TEMPLATE=
# Dev-server port (1024..65535, default 5173) and sandbox lifetime in seconds
# (120..3600, default 1800). Idle expiry (60..lifetime, default 600).
MAVLY_RUNTIME_SANDBOX_PORT=
MAVLY_RUNTIME_SANDBOX_MAX_LIFETIME_SECONDS=
MAVLY_RUNTIME_SANDBOX_IDLE_SECONDS=
# Install (30..420 s, default 120) and dev-server startup (20..180 s, default 60).
# The defaults fit the Start route's 300 s budget; larger values may time out.
MAVLY_RUNTIME_SANDBOX_INSTALL_TIMEOUT_SECONDS=
MAVLY_RUNTIME_SANDBOX_STARTUP_TIMEOUT_SECONDS=
# Sync limits: files (10..1000), per-file bytes (default 262144) and total bytes
# (default 4194304). Files over a limit are skipped and reported, never truncated.
MAVLY_RUNTIME_SANDBOX_MAX_FILES=
MAVLY_RUNTIME_SANDBOX_MAX_FILE_BYTES=
MAVLY_RUNTIME_SANDBOX_MAX_TOTAL_BYTES=
# Active sandboxes per user (1..5, default 2).
MAVLY_RUNTIME_SANDBOX_MAX_ACTIVE_PER_USER=
# Let QA/Security read the durable runtime evidence, and separately allow the one
# approved `vite build` action. Both default off.
MAVLY_RUNTIME_SANDBOX_QA_EVIDENCE=
MAVLY_RUNTIME_SANDBOX_QA_BUILD=

# Isolated verification sandbox (Phase 3 build + Phase 4 runtime). Off by
# default. Enabling requires ALL of: the flag, an explicit project cohort,
# provider credentials, the service-role key and the Supabase URL. Install,
# build and the loopback runtime/health check run in a managed microVM, never
# on the Mavly server. `passed` requires the build, the runtime start and a
# local 2xx/3xx health response. Provider: vercel (default); e2b is not
# implemented.
MAVLY_VERIFICATION_SANDBOX_ENABLED=
MAVLY_VERIFICATION_SANDBOX_PROVIDER=
# Comma/semicolon-separated project ids. Empty, '*' or a space inside an entry
# is NOT accepted. (This parser is independent of generation dispatch.)
MAVLY_VERIFICATION_SANDBOX_PROJECTS=
# Bounded AI repair (Phase 4). Separately opt-in and never implied by the flag
# above; it also needs a configured generation provider (OPENROUTER_API_KEY). Only
# build/runtime/health source failures are eligible. A repair creates an
# immutable snapshot and never edits the user's project.
MAVLY_VERIFICATION_REPAIR_ENABLED=
# 0..2. Defaults to 1 when repair is enabled; higher values are clamped to 2.
# 0 disables repair even when the flag above is on.
MAVLY_VERIFICATION_MAX_REPAIRS=
# Vercel Sandbox auth: either VERCEL_OIDC_TOKEN, or the access-token triple.
VERCEL_OIDC_TOKEN=
# The VERCEL_TOKEN / VERCEL_TEAM_ID / VERCEL_PROJECT_ID variables above/below
# are also read by the verification sandbox when OIDC is absent.
MAVLY_INTEGRATION_ENCRYPTION_KEY=
MAVLY_PROJECT_SECRETS_ENCRYPTION_KEY=
# Hosting mode is reserved for future provider-neutral hosting. Leave unset.
# 'shared' is not a customer deployment provider and remains disabled unless explicitly configured.
MAVLY_HOSTING_MODE=
# Comma-separated project ids, or '*' for all projects. Empty = no shared sites.
MAVLY_SHARED_HOSTING_PROJECTS=
# Full-stack production hosting (Phase 5). Off by default. Enabling requires ALL
# of: this flag, an explicit project cohort, the Vercel publishing configuration
# above, and MAVLY_PROJECT_SECRETS_ENCRYPTION_KEY. Server route handlers run in
# the Vercel deployment, never on a Mavly host. A project must also have a
# PASSED build/runtime verification for the exact snapshot being deployed.
MAVLY_FULLSTACK_HOSTING_ENABLED=
# Comma/semicolon-separated project ids. Empty, '*' or a space inside an entry
# is NOT accepted: a full-stack deployment is an explicit, named cohort.
MAVLY_FULLSTACK_HOSTING_PROJECTS=
# Business integrations (Phase 6). Off by default. Enabling requires ALL of:
# this flag, an explicit project cohort, MAVLY_PROJECT_SECRETS_ENCRYPTION_KEY and
# a configured Supabase URL/anon key. Razorpay credentials are entered per
# project in the workspace and stored encrypted as project secrets; they are
# never environment variables on Mavly. The gateway exposes only
# /api/app/v1/payments/* (project API key + integrations:* scope) and
# /api/integrations/webhooks/razorpay/* (signed raw body).
MAVLY_BUSINESS_INTEGRATIONS_ENABLED=
# Comma/semicolon-separated project ids. Empty, '*' or a space inside an entry
# is NOT accepted: this spends real provider money for a named cohort only.
MAVLY_BUSINESS_INTEGRATIONS_PROJECTS=
# Server-only proof (>=32 chars) for the anon-callable webhook write RPCs. The
# migration stores sha256(secret) on each integration; the provider webhook
# secret is still the signature authority. Rotate it by updating this value and
# re-saving each integration. Never give it a NEXT_PUBLIC_ prefix.
MAVLY_BUSINESS_INTEGRATIONS_RPC_SECRET=
# Agent memory (Phase 8). Off by default and restricted to an explicit cohort.
# Enabling requires migration 24 and a configured Supabase URL/anon key. When
# off, persistent memory, retrieval selection and plan requests are disabled and
# generation uses the existing full-file context/provider pipeline. No new secret
# is needed: decisions and observed failure notes are RLS-scoped project data.
MAVLY_AGENT_MEMORY_ENABLED=
# Comma/semicolon-separated project ids. Empty, '*' or a space inside an entry
# is NOT accepted.
MAVLY_AGENT_MEMORY_PROJECTS=
# Multi-agent orchestration (Phase 10). OFF by default and cohort-scoped.
# Enabling requires ALL of: the flag, an explicit project cohort, a ready
# durable generation worker (migration 16 + its configuration), the service-role
# key and OPENROUTER_API_KEY. It runs ONLY for worker-dispatched runs, reusing
# the same `project_runs` job/lease, checkpoints, snapshots, provider and
# verification pipeline. An inline after() run keeps the existing behavior and
# records no workflow.
MAVLY_MULTI_AGENT_ENABLED=
# Comma/semicolon-separated project ids. Empty, '*' or a space inside an entry
# is NOT accepted.
MAVLY_MULTI_AGENT_PROJECTS=
# Diagnostic repair role. Never writes source in Phase 10; it records a bounded
# diagnosis after a failed run. 0 disables it even when this flag is on.
MAVLY_MULTI_AGENT_REPAIR_ENABLED=
# 0..2. Defaults to 1 when repair is enabled; values are clamped.
MAVLY_MULTI_AGENT_MAX_REPAIRS=
# 1..24 billable model calls per workflow. Default 8. Clamped.
MAVLY_MULTI_AGENT_MAX_PROVIDER_CALLS=
# 30000..900000 ms total orchestration budget. Default 240000. Clamped.
MAVLY_MULTI_AGENT_MAX_WALL_CLOCK_MS=
# Server-enforced production approval gate. Independent of the orchestration
# flag: it is ALSO applied automatically to every project in the multi-agent
# cohort. A publish without an approved, unexpired proposal bound to the exact
# server-derived source is refused with 428 DEPLOYMENT_APPROVAL_REQUIRED.
# Requires migration 29.
MAVLY_DEPLOYMENT_APPROVAL_REQUIRED=
# 5..1440 minutes. Default 60.
MAVLY_DEPLOYMENT_APPROVAL_TTL_MINUTES=
# Canonical public origin users open (e.g. https://mavly.xyz). It is the CORS
# allowlist entry AND the host that decides the Secure flag on Supabase session
# cookies: an https value enables Secure, an http one (local `next start`)
# keeps them usable. Supabase's Site URL + redirect allowlist must use the same
# origin, or a sign-in started on one host lands without the other host's
# cookies.
NEXT_PUBLIC_APP_URL=
# Extra exact origins allowed to make credentialed API calls (comma-separated).
# Never add a tenant host here.
MAVLY_ALLOWED_ORIGINS=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
# AWS background worker mode. Set to true on the EC2 host to activate the AWS
# worker; leave unset or false when the host is not active.
MAVLY_AWS_WORKER=
# Render is preserved as a future fallback. Keep this true while AWS is the only
# active worker host to prevent accidental double-processing of the queue.
MAVLY_RENDER_WORKER_DISABLED=
# The legacy Cloudflare Cron worker is retained but disabled while AWS is active.
# Set true in the Cloudflare Worker environment; the configured cron then no-ops.
MAVLY_CLOUDFLARE_WORKER_DISABLED=
# Website and native Android source generation use OpenRouter through the
# server-side chat-completions client.
# Optional. Overrides the default model only when it is in OpenRouter's catalog.
MAVLY_DEFAULT_MODEL=
# Cohort-gated OpenRouter model evaluation. Empty disables the Cohere model;
# set explicit project ids (comma/semicolon separated; never '*') to enable it.
MAVLY_NORTH_MINI_CODE_PROJECTS=
# Optional. The maximum number of provider requests ONE generation run may make
# (4..40, default 12). A run that reaches it stops with a typed, resumable
# failure instead of fanning out into more paid calls.
MAVLY_MAX_PROVIDER_ATTEMPTS_PER_RUN=
# ── Optional Phase 9 Android DEBUG build engine ──────────────────────────────
# OFF by default. A build runs only when ALL of these are present and valid:
#   · the flag below is 1/true/yes/on;
#   · an explicit, comma/semicolon-separated project cohort (never '*'/empty);
#   · a Vercel Container Registry (VCR) image pinned by @sha256 (tags are
#     rejected, as are Docker Hub/GHCR/other external registries);
#   · a private Supabase Storage bucket with the APK policy;
#   · Vercel Sandbox credentials and the service-role key/Supabase URL;
#   · the active AWS generation worker is running, because it advances build jobs
#     when no generation job is ready. The legacy Cloudflare Cron must remain disabled.
#
# The image is built from `infra/android-build/` (JDK 17, Gradle 8.9, Android
# SDK/build-tools 35, aapt, warmed Gradle cache). Builds run
# `gradle :app:assembleDebug --no-daemon --offline` with deny-all network, so a
# dependency outside the warmed baseline fails instead of downloading it.
# Debug APK only: no release signing, AAB, device test or store publishing.
MAVLY_ANDROID_BUILD_ENABLED=
# Explicit project ids. Empty, '*' or a space inside an entry is NOT accepted.
# Keep this to one disposable project until the acceptance checklist passes.
MAVLY_ANDROID_BUILD_PROJECTS=
# Example shape (replace with the digest printed by infra/android-build/publish.sh):
#   MAVLY_ANDROID_BUILD_IMAGE=<team>/<project>/android-build@sha256:<64 hex>
# This is a PLACEHOLDER, not a real digest. Do not use it as-is.
MAVLY_ANDROID_BUILD_IMAGE=
# Migration 26 creates `android-artifacts` private (100 MB, APK MIME). A
# different name is allowed only if you created that bucket private with the
# same policy; Mavly cannot inspect the bucket policy from here.
MAVLY_ANDROID_ARTIFACT_BUCKET=android-artifacts
# 1..4. 2048 MB of provider memory is allocated per vCPU.
MAVLY_ANDROID_BUILD_VCPUS=2
# OpenRouter is the text-generation and image-generation provider. The
# `cohere/north-mini-code:free` model is selectable only for the explicit
# project cohort in MAVLY_NORTH_MINI_CODE_PROJECTS; it never becomes the default.
# Server-only. Required for text and image generation.
OPENROUTER_API_KEY=
# Server-only. Used ONLY by the durable worker; never expose to the browser and
# never add a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=
# Verification sandbox access-token triple (only when VERCEL_OIDC_TOKEN is not
# used). Customer-app publishing credentials are intentionally not configured here.
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
# ═══ CREDITS (OFF BY DEFAULT) ═══════════════════════════════════════════════
# Authoritative credit accounting needs supabase/migrations/31_credit_foundation.sql.
# Credit admission also requires the durable worker and a matching
# service-managed credit_project_policies row. Keep the database cohort/cost in
# sync with these values. There is no Mavly credit-funding flow yet, so enabling
# a charge without granting credits first refuses with INSUFFICIENT_CREDITS.
# Grant credits only through the service-role `grant_credits` RPC.
MAVLY_CREDITS_ENABLED=
# Explicit comma/semicolon-separated project ids. Never '*' or empty.
MAVLY_CREDITS_PROJECTS=
# Whole credits reserved per generation run (1..100000). No default.
MAVLY_CREDITS_GENERATION_COST=

# ═══ ROLE-SPECIFIC MODELS (NO ENVIRONMENT OVERRIDE) ═════════════════════════
# The seven orchestration roles are pinned in src/lib/ai/model-roles.ts. Only
# deepseek/deepseek-v4.1-flash and the cohort-gated Cohere model are currently
# treated as verified catalog entries. All model roles use the verified
# DeepSeek entry until requested specialist IDs have been verified and added to
# the catalog. There is deliberately NO environment override.
#   planner/ui_ux/coding/qa/security/repair  deepseek/deepseek-v4.1-flash
#   deployment  deterministic (no model call)
