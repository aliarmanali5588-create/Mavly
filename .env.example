GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=
MAVLY_DEFAULT_MODEL=
# Durable generation worker. Leave disabled for the inline after() path.
# Enabling requires ALL of: flag, a >=32-char secret shared with the scheduler,
# an explicit project cohort, SUPABASE_SERVICE_ROLE_KEY and the Supabase URL.
MAVLY_GENERATION_WORKER_ENABLED=
MAVLY_GENERATION_WORKER_SECRET=
# Comma/space-separated project ids. Empty or '*' is NOT accepted.
MAVLY_GENERATION_WORKER_PROJECTS=
# Optional log-safe identity for this worker instance.
MAVLY_GENERATION_WORKER_ID=
MAVLY_IMAGE_MODEL=
# Isolated verification sandbox (Phase 3). Off by default. Enabling requires
# ALL of: the flag, an explicit project cohort, provider credentials, the
# service-role key and the Supabase URL. The build runs in a managed microVM,
# never on the Mavly server. Provider: vercel (default); e2b is not implemented.
MAVLY_VERIFICATION_SANDBOX_ENABLED=
MAVLY_VERIFICATION_SANDBOX_PROVIDER=
# Comma/semicolon-separated project ids. Empty, '*' or a space inside an entry
# is NOT accepted. (This parser is separate from the worker cohort above.)
MAVLY_VERIFICATION_SANDBOX_PROJECTS=
# Vercel Sandbox auth: either VERCEL_OIDC_TOKEN, or the access-token triple.
VERCEL_OIDC_TOKEN=
# The VERCEL_TOKEN / VERCEL_TEAM_ID / VERCEL_PROJECT_ID variables above/below
# are also read by the verification sandbox when OIDC is absent.
MAVLY_INTEGRATION_ENCRYPTION_KEY=
MAVLY_PROJECT_SECRETS_ENCRYPTION_KEY=
MAVLY_VERCEL_DEPLOYMENTS_ENABLED=
# Hosting mode: leave unset (or 'vercel') for per-project Vercel publishing.
# 'shared' enables the tenant runtime ONLY for the project ids listed below.
MAVLY_HOSTING_MODE=
# Comma-separated project ids, or '*' for all projects. Empty = no shared sites.
MAVLY_SHARED_HOSTING_PROJECTS=
NEXT_PUBLIC_APP_URL=
# Extra exact origins allowed to make credentialed API calls (comma-separated).
# Never add a tenant host here.
MAVLY_ALLOWED_ORIGINS=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
# Website/code generation (Next.js server runtime)
GROQ_API_KEY=
# Image generation; preserved OpenRouter chat client is not active
OPENROUTER_API_KEY=
SUPABASE_OAUTH_CLIENT_ID=
SUPABASE_OAUTH_CLIENT_SECRET=
SUPABASE_OAUTH_REDIRECT_URI=
# Server-only. Used ONLY by the durable worker; never expose to the browser and
# never add a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=
VERCEL_API_TOKEN=
VERCEL_PROJECT_PREFIX=
# Verification sandbox access-token triple (only when VERCEL_OIDC_TOKEN is not
# used). VERCEL_API_TOKEN above is the separate publishing credential.
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=