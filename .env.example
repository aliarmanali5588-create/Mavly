GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=
MAVLY_DEFAULT_MODEL=
# Durable generation worker. Leave disabled for the inline after() path.
# Enabling requires ALL of: flag, a >=32-char secret shared with the scheduler,
# an explicit project cohort, SUPABASE_SERVICE_ROLE_KEY and the Supabase URL.
MAVLY_GENERATION_WORKER_ENABLED=
MAVLY_GENERATION_WORKER_SECRET=
# Comma/space-separated project ids. Empty or '*' is NOT accepted.
MAVLY_GENERATION_WORKER_PROJECTS=
# Optional log-safe identity for this worker instance.
MAVLY_GENERATION_WORKER_ID=
MAVLY_IMAGE_MODEL=
# Isolated verification sandbox (Phase 3 build + Phase 4 runtime). Off by
# default. Enabling requires ALL of: the flag, an explicit project cohort,
# provider credentials, the service-role key and the Supabase URL. Install,
# build and the loopback runtime/health check run in a managed microVM, never
# on the Mavly server. `passed` requires the build, the runtime start and a
# local 2xx/3xx health response. Provider: vercel (default); e2b is not
# implemented.
MAVLY_VERIFICATION_SANDBOX_ENABLED=
MAVLY_VERIFICATION_SANDBOX_PROVIDER=
# Comma/semicolon-separated project ids. Empty, '*' or a space inside an entry
# is NOT accepted. (This parser is separate from the worker cohort above.)
MAVLY_VERIFICATION_SANDBOX_PROJECTS=
# Bounded AI repair (Phase 4). Separately opt-in and never implied by the flag
# above; it also needs a configured generation model (GROQ_API_KEY). Only
# build/runtime/health source failures are eligible. A repair creates an
# immutable snapshot and never edits the user's project.
MAVLY_VERIFICATION_REPAIR_ENABLED=
# 0..2. Defaults to 1 when repair is enabled; higher values are clamped to 2.
# 0 disables repair even when the flag above is on.
MAVLY_VERIFICATION_MAX_REPAIRS=
# Vercel Sandbox auth: either VERCEL_OIDC_TOKEN, or the access-token triple.
VERCEL_OIDC_TOKEN=
# The VERCEL_TOKEN / VERCEL_TEAM_ID / VERCEL_PROJECT_ID variables above/below
# are also read by the verification sandbox when OIDC is absent.
MAVLY_INTEGRATION_ENCRYPTION_KEY=
MAVLY_PROJECT_SECRETS_ENCRYPTION_KEY=
MAVLY_VERCEL_DEPLOYMENTS_ENABLED=
# Hosting mode: leave unset (or 'vercel') for per-project Vercel publishing.
# 'shared' enables the tenant runtime ONLY for the project ids listed below.
MAVLY_HOSTING_MODE=
# Comma-separated project ids, or '*' for all projects. Empty = no shared sites.
MAVLY_SHARED_HOSTING_PROJECTS=
# Full-stack production hosting (Phase 5). Off by default. Enabling requires ALL
# of: this flag, an explicit project cohort, the Vercel publishing configuration
# above, and MAVLY_PROJECT_SECRETS_ENCRYPTION_KEY. Server route handlers run in
# the Vercel deployment, never on a Mavly host. A project must also have a
# PASSED build/runtime verification for the exact snapshot being deployed.
MAVLY_FULLSTACK_HOSTING_ENABLED=
# Comma/semicolon-separated project ids. Empty, '*' or a space inside an entry
# is NOT accepted: a full-stack deployment is an explicit, named cohort.
MAVLY_FULLSTACK_HOSTING_PROJECTS=
# Business integrations (Phase 6). Off by default. Enabling requires ALL of:
# this flag, an explicit project cohort, MAVLY_PROJECT_SECRETS_ENCRYPTION_KEY and
# a configured Supabase URL/anon key. Razorpay credentials are entered per
# project in the workspace and stored encrypted as project secrets; they are
# never environment variables on Mavly. The gateway exposes only
# /api/app/v1/payments/* (project API key + integrations:* scope) and
# /api/integrations/webhooks/razorpay/* (signed raw body).
MAVLY_BUSINESS_INTEGRATIONS_ENABLED=
# Comma/semicolon-separated project ids. Empty, '*' or a space inside an entry
# is NOT accepted: this spends real provider money for a named cohort only.
MAVLY_BUSINESS_INTEGRATIONS_PROJECTS=
# Server-only proof (>=32 chars) for the anon-callable webhook write RPCs. The
# migration stores sha256(secret) on each integration; the provider webhook
# secret is still the signature authority. Rotate it by updating this value and
# re-saving each integration. Never give it a NEXT_PUBLIC_ prefix.
MAVLY_BUSINESS_INTEGRATIONS_RPC_SECRET=
# Agent memory (Phase 8). Off by default and restricted to an explicit cohort.
# Enabling requires migration 24 and a configured Supabase URL/anon key. When
# off, persistent memory, retrieval selection and plan requests are disabled and
# generation uses the existing full-file context/provider pipeline. No new secret
# is needed: decisions and observed failure notes are RLS-scoped project data.
MAVLY_AGENT_MEMORY_ENABLED=
# Comma/semicolon-separated project ids. Empty, '*' or a space inside an entry
# is NOT accepted.
MAVLY_AGENT_MEMORY_PROJECTS=
# Canonical public origin users open (e.g. https://mavly.xyz). It is the CORS
# allowlist entry AND the host that decides the Secure flag on Supabase session
# cookies: an https value enables Secure, an http one (local `next start`)
# keeps them usable. Supabase's Site URL + redirect allowlist must use the same
# origin, or a sign-in started on one host lands without the other host's
# cookies.
NEXT_PUBLIC_APP_URL=
# Extra exact origins allowed to make credentialed API calls (comma-separated).
# Never add a tenant host here.
MAVLY_ALLOWED_ORIGINS=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
# Website and native Android source generation (Next.js server runtime). Android
# uses the same Groq model.
GROQ_API_KEY=
# ── Optional Phase 9 Android DEBUG build engine ──────────────────────────────
# Off unless ALL prerequisites are present. The image MUST be a Vercel Container
# Registry (VCR) image pinned by digest (@sha256:...); the Sandbox provider does
# not accept arbitrary external registries. It must contain JDK 17, Gradle 8.9,
# Android SDK 35 and aapt, and carry a pre-populated Gradle cache: builds run
# with --offline and no network.
# Release signing, AABs, store publishing and emulator preview are not included.
MAVLY_ANDROID_BUILD_ENABLED=
MAVLY_ANDROID_BUILD_PROJECTS=
MAVLY_ANDROID_BUILD_IMAGE=
MAVLY_ANDROID_ARTIFACT_BUCKET=android-artifacts
MAVLY_ANDROID_BUILD_VCPUS=2
# The build worker reuses the Vercel Sandbox credentials below and
# SUPABASE_SERVICE_ROLE_KEY; the generation worker must also be enabled.
# Image generation; preserved OpenRouter chat client is not active
OPENROUTER_API_KEY=
SUPABASE_OAUTH_CLIENT_ID=
SUPABASE_OAUTH_CLIENT_SECRET=
SUPABASE_OAUTH_REDIRECT_URI=
# Server-only. Used ONLY by the durable worker; never expose to the browser and
# never add a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=
VERCEL_API_TOKEN=
VERCEL_PROJECT_PREFIX=
# Verification sandbox access-token triple (only when VERCEL_OIDC_TOKEN is not
# used). VERCEL_API_TOKEN above is the separate publishing credential.
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=