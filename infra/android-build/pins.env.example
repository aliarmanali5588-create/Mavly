# Copy this file to `pins.env` (which must NOT be committed) and fill in every
# value. `build.sh` refuses to run while any value is missing or a checksum is
# not 64 hex characters.
#
# Where to get each pin:
#
#   BASE_IMAGE
#     A digest-pinned Ubuntu 24.04 (amd64) base. Resolve the current digest with:
#       docker buildx imagetools inspect ubuntu:24.04
#     then use: ubuntu:24.04@sha256:<digest>
#
#   JDK_URL / JDK_SHA256
#     An immutable Adoptium Temurin 17 linux/x64 tarball from the GitHub release
#     (the URL contains the exact patch/build, e.g. jdk-17.0.N%2BM). The official
#     checksum is published next to the archive as a `.sha256.txt` file.
#
#   GRADLE_SHA256
#     From https://services.gradle.org/distributions/gradle-8.9-bin.zip.sha256
#
#   CMDLINE_TOOLS_URL / CMDLINE_TOOLS_SHA256
#     A versioned `commandlinetools-linux-<build>_latest.zip` from
#     https://developer.android.com/studio#command-line-tools-only
#     Download it once and record `sha256sum` of the exact archive. Google does
#     not provide a mutable-free URL, so the recorded checksum is the pin.
#
# A published image digest is not secret, but keep this file local so an
# operator cannot accidentally build from an unreviewed base.

BASE_IMAGE=ubuntu:24.04@sha256:<64 hex>
JDK_URL=https://github.com/adoptium/temurin17-binaries/releases/download/jdk-17.0.<patch>%2B<build>/OpenJDK17U-jdk_x64_linux_hotspot_17.0.<patch>_<build>.tar.gz
JDK_SHA256=<64 hex>
GRADLE_SHA256=<64 hex>
CMDLINE_TOOLS_URL=https://dl.google.com/android/repository/commandlinetools-linux-<build>_latest.zip
CMDLINE_TOOLS_SHA256=<64 hex>
