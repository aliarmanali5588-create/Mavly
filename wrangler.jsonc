{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mavly-generation-worker",
  "main": "workers/generation-scheduler.ts",
  "compatibility_date": "2026-10-30",
  "workers_dev": false,
  "vars": {
    "NODE_ENV": "production",
    "MAVLY_CLOUDFLARE_WORKER": "true",
    "MAVLY_CLOUDFLARE_WORKER_DISABLED": "true"
  },
  // Retained for rollback only. The scheduler no-ops while the disable flag is true.
  "triggers": {
    "crons": ["* * * * *"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
